@page "/home/hackathons/organizer/{id:guid}/decisions"
@using GroundZero.Web.Entities
@using SqlSugar

@rendermode InteractiveServer
@attribute [StreamRendering]

@inject ISqlSugarClient Db

<NavContainer HackathonId="Id" HackathonName="@Hackathon?.Name">
    <HxListLayout Title="Decisions" TFilterModel="HxListLayout.NoFilter">
        <DataTemplate>
            <HxGrid TItem="Decision" DataProvider="DataProvider" Responsive="true">
                <Columns>
                    <HxGridColumn HeaderText="ID" ItemTextSelector="j => j.Id.ToString()"></HxGridColumn>
                    <HxGridColumn HeaderText="Name" ItemTextSelector="j => j.WinnerId.ToString()"></HxGridColumn>
                    <HxGridColumn HeaderText="Alpha" ItemTextSelector="j => j.LoserId.ToString()"></HxGridColumn>
                </Columns>
            </HxGrid>
        </DataTemplate>
    </HxListLayout>
</NavContainer>

@code {

    [Parameter] public Guid Id { get; set; }
    
    [PersistentState] public Hackathon? Hackathon { get; set; }
    [PersistentState] public List<Decision>? DecisionList { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Hackathon ??= await Db.Queryable<Hackathon>()
            .Includes(h => h.Judges, j => j.NextTeam)
            .Includes(h => h.Judges, j => j.PreviousTeam)
            .SingleAsync(h => h.Id == Id);
    }
    
    public async Task<GridDataProviderResult<Decision>> DataProvider(GridDataProviderRequest<Decision> request)
    {
        var data = await Db.Queryable<Decision>()
            .Includes(d => d.Judge)
            .Where(d => d.Judge.HackathonId == Id)
            .ToListAsync();
        
        return new GridDataProviderResult<Decision>
        {
            Data = data.AsQueryable().ApplyGridDataProviderRequest(request),
            TotalCount = data.Count
        };
    }
}